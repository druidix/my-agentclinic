<header class="container">
  <nav aria-label="Main">
    <ul>
      <li><a class="brand" href="/"><strong>AgentClinic</strong></a></li>
    </ul>
    <ul class="nav-links">
      <% nav.forEach(function (item) { %>
        <li>
          <a href="<%= item.href %>"<% if (item.href === activeHref) { %> aria-current="page"<% } %>><%= item.label %></a>
        </li>
      <% }) %>
    </ul>
  </nav>
</header>
