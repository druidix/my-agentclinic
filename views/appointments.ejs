<hgroup>
  <h1><%= title %></h1>
  <p>Every session at the clinic, in your local time.</p>
</hgroup>

<% if (booked) { %>
<p role="status">Booked: <%= booked.agent.name %> with <%= booked.therapy.name %> on <time datetime="<%= booked.startsAt %>"><%= booked.when %></time>.</p>
<% } %>
<p><a href="/appointments/new" role="button">Book an appointment</a></p>

<div class="overflow-auto">
  <table>
    <caption>Appointments, soonest first</caption>
    <thead>
      <tr>
        <th scope="col">When</th>
        <th scope="col">Agent</th>
        <th scope="col">Therapy</th>
        <th scope="col">Status</th>
      </tr>
    </thead>
    <tbody>
      <% appointments.forEach(function (appointment) { %>
      <tr id="appointment-<%= appointment.id %>">
        <th scope="row"><time datetime="<%= appointment.startsAt %>"><%= appointment.when %></time></th>
        <td><a href="/agents#agent-<%= appointment.agent.id %>"><%= appointment.agent.name %></a></td>
        <td><a href="/therapies#therapy-<%= appointment.therapy.id %>"><%= appointment.therapy.name %></a></td>
        <td><span class="badge badge-<%= appointment.status %>"><%= appointment.status %></span></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>
