<hgroup>
  <h1><%= title %></h1>
  <p>What is going around the clinic, and who has it.</p>
</hgroup>

<% ailments.forEach(function (ailment) { %>
<article>
  <h2><%= ailment.name %></h2>
  <p><%= ailment.description %></p>
  <p>Agents with this ailment:</p>
  <ul>
    <% ailment.agents.forEach(function (agent) { %>
    <li><a href="/agents#agent-<%= agent.id %>"><%= agent.name %></a></li>
    <% }) %>
  </ul>
</article>
<% }) %>
